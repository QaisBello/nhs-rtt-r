/// Every provider in the August 2026 extract (NHS trusts and independent sector).
table Providers

	column provider_code
		dataType: string
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: provider_code

	column provider
		dataType: string
		summarizeBy: none
		sourceColumn: provider

	column waiting
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: waiting

	column within_18
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: within_18

	column over_52
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_52

	column over_65
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_65

	column median_weeks
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: median_weeks

	column p92_weeks
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: p92_weeks

	column pct_within_18
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: pct_within_18

	column pct_over_52
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: pct_over_52

	column independent
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: independent

	column small
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: small

	column Sector
		dataType: string
		summarizeBy: none
		sourceColumn: Sector

	partition Providers = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "provider_summary.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {{"independent", each if _ = null then null else Text.Lower(_)}, {"small", each if _ = null then null else Text.Lower(_)}}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"provider_code", type text},
				            {"provider", type text},
				            {"waiting", Int64.Type},
				            {"within_18", Int64.Type},
				            {"over_52", Int64.Type},
				            {"over_65", Int64.Type},
				            {"median_weeks", type number},
				            {"p92_weeks", type number},
				            {"pct_within_18", type number},
				            {"pct_over_52", type number},
				            {"independent", type logical},
				            {"small", type logical}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    #"Sector" = Table.AddColumn(#"Filtered Rows", "Sector", each if [independent] then "Independent sector" else "NHS trust", type text),
				    Result = #"Sector"
				in
				    Result
				```

