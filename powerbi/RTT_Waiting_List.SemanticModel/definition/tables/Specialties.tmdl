/// Treatment functions, England totals (August 2026).
table Specialties

	/// England figure per treatment function (excludes non-English commissioners).
	measure 'Specialty % Within 18 Weeks' = DIVIDE ( SUM ( Specialties[within_18] ), SUM ( Specialties[waiting] ) )
		formatString: 0.0%
		displayFolder: Specialties

	/// Pathways over a year, by treatment function.
	measure 'Specialty Over 52 Weeks' = SUM ( Specialties[over_52] )
		formatString: #,0
		displayFolder: Specialties

	column specialty_code
		dataType: string
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: specialty_code

	column specialty
		dataType: string
		summarizeBy: none
		sourceColumn: specialty

	column waiting
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: waiting

	column within_18
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: within_18

	column over_52
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_52

	column over_65
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_65

	column median_weeks
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: median_weeks

	column p92_weeks
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: p92_weeks

	column pct_within_18
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: pct_within_18

	column pct_over_52
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: pct_over_52

	partition Specialties = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "specialty_summary.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"specialty_code", type text},
				            {"specialty", type text},
				            {"waiting", Int64.Type},
				            {"within_18", Int64.Type},
				            {"over_52", Int64.Type},
				            {"over_65", Int64.Type},
				            {"median_weeks", type number},
				            {"p92_weeks", type number},
				            {"pct_within_18", type number},
				            {"pct_over_52", type number}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

