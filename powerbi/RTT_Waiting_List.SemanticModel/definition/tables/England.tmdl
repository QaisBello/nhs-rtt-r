/// England each month since August 2007 (NHS England RTT overview time series). Excludes pathways commissioned outside England, as NHS England's headline figures do.
table England

	/// Latest month of data.
	measure 'Latest Month' = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )
		formatString: mmmm yyyy
		displayFolder: England

	/// Incomplete pathways (people waiting), reported providers only.
	measure 'Waiting List' = SUM ( England[waiting] )
		formatString: #,0
		displayFolder: England

	/// Including NHS England's estimates for trusts that did not report.
	measure 'Waiting List with Estimates' = SUM ( England[waiting_with_estimates] )
		formatString: #,0
		displayFolder: England

	/// Share waiting less than 18 weeks (the constitutional standard is 92%).
	measure '% Within 18 Weeks' = DIVIDE ( SUM ( England[within_18] ), SUM ( England[waiting] ) )
		formatString: 0.0%
		displayFolder: England

	/// The constitutional standard.
	measure '92% Standard' = 0.92
		formatString: 0%
		displayFolder: England

	/// The March 2027 interim target.
	measure '70% Target' = 0.70
		formatString: 0%
		displayFolder: England

	/// Waiting list in the latest month.
	measure 'Latest Waiting List' =
			VAR _last = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )
			RETURN CALCULATE ( [Waiting List], REMOVEFILTERS ( England ), England[month] = _last )
		formatString: #,0
		displayFolder: England

	/// Share within 18 weeks in the latest month.
	measure 'Latest % Within 18 Weeks' =
			VAR _last = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )
			RETURN CALCULATE ( [% Within 18 Weeks], REMOVEFILTERS ( England ), England[month] = _last )
		formatString: 0.0%
		displayFolder: England

	/// Median wait in weeks, latest month (interpolated within weekly bands).
	measure 'Latest Median Wait' =
			VAR _last = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )
			RETURN CALCULATE ( MAX ( England[median_weeks] ), REMOVEFILTERS ( England ), England[month] = _last )
		formatString: 0.0
		displayFolder: England

	/// 92nd percentile wait in weeks: the standard says 92% should wait less than 18.
	measure 'Latest 92nd Percentile' =
			VAR _last = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )
			RETURN CALCULATE ( MAX ( England[p92_weeks] ), REMOVEFILTERS ( England ), England[month] = _last )
		formatString: 0.0
		displayFolder: England

	/// Pathways waiting more than a year.
	measure 'Latest Over 52 Weeks' =
			VAR _last = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )
			RETURN CALCULATE ( SUM ( England[over_52] ), REMOVEFILTERS ( England ), England[month] = _last )
		formatString: #,0
		displayFolder: England

	/// Largest list on record.
	measure 'Peak Waiting List' = CALCULATE ( MAX ( England[waiting] ), REMOVEFILTERS ( England ) )
		formatString: #,0
		displayFolder: England

	/// Month of the largest list.
	measure 'Peak Month' =
			VAR _peak = [Peak Waiting List]
			RETURN
			    CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ), England[waiting] = _peak )
		formatString: mmmm yyyy
		displayFolder: England

	/// The last month England met the 92% standard.
	measure 'Last Month 92% Was Met' = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ), England[within_18] >= 0.92 * England[waiting] )
		formatString: mmmm yyyy
		displayFolder: England

	/// Percentage points still to go.
	measure 'Gap to 70%' = 100 * ( [70% Target] - [Latest % Within 18 Weeks] )
		formatString: 0.0" points"
		displayFolder: England

	column month
		dataType: dateTime
		isKey
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: month

	column median_weeks
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: median_weeks

	column within_18
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: within_18

	column pct_within_18
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: pct_within_18

	column over_18
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_18

	column over_52
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_52

	column over_65
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_65

	column over_78
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_78

	column over_104
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_104

	column waiting
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: waiting

	column waiting_with_estimates
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: waiting_with_estimates

	column p92_off_scale
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: p92_off_scale

	column p92_weeks
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: p92_weeks

	partition England = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "england_timeseries.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {{"p92_off_scale", each if _ = null then null else Text.Lower(_)}}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"month", type datetime},
				            {"median_weeks", type number},
				            {"within_18", Int64.Type},
				            {"pct_within_18", type number},
				            {"over_18", Int64.Type},
				            {"over_52", Int64.Type},
				            {"over_65", Int64.Type},
				            {"over_78", Int64.Type},
				            {"over_104", Int64.Type},
				            {"waiting", Int64.Type},
				            {"waiting_with_estimates", Int64.Type},
				            {"p92_off_scale", type logical},
				            {"p92_weeks", type number}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

