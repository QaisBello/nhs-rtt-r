/// The 139 NHS trusts in the funnel plot, with the R analysis's z-scores and bands (binomial and overdispersed).
table Funnel

	/// Trust waiting list (funnel x axis).
	measure 'Funnel List Size' = SUM ( Funnel[waiting] )
		formatString: #,0
		displayFolder: Funnel

	/// Trust performance (funnel y axis).
	measure 'Funnel % Within 18 Weeks' = DIVIDE ( SUM ( Funnel[within_18] ), SUM ( Funnel[waiting] ) )
		formatString: 0.0%
		displayFolder: Funnel

	/// Above the overdispersed 99.8% limit.
	measure 'Trusts Better Than Chance' = CALCULATE ( COUNTROWS ( Funnel ), Funnel[band] = "Above 99.8% limit" )
		formatString: #,0
		displayFolder: Funnel

	/// Below the overdispersed 99.8% limit.
	measure 'Trusts Worse Than Chance' = CALCULATE ( COUNTROWS ( Funnel ), Funnel[band] = "Below 99.8% limit" )
		formatString: #,0
		displayFolder: Funnel

	/// Trusts outside plain binomial 99.8% limits: nearly all of them, which is why overdispersion matters.
	measure 'Binomial Outliers' = CALCULATE ( COUNTROWS ( Funnel ), ABS ( Funnel[z_binomial] ) > 3.09 )
		formatString: #,0
		displayFolder: Funnel

	column provider_code
		dataType: string
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: provider_code

	column provider
		dataType: string
		summarizeBy: none
		sourceColumn: provider

	column waiting
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: waiting

	column within_18
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: within_18

	column over_52
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_52

	column over_65
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_65

	column median_weeks
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: median_weeks

	column p92_weeks
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: p92_weeks

	column pct_within_18
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: pct_within_18

	column pct_over_52
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: pct_over_52

	column independent
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: independent

	column small
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: small

	column p
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: p

	column z_binomial
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: z_binomial

	column z
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: z

	column band
		dataType: string
		summarizeBy: none
		sourceColumn: band

	partition Funnel = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "funnel_trusts.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {{"independent", each if _ = null then null else Text.Lower(_)}, {"small", each if _ = null then null else Text.Lower(_)}}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"provider_code", type text},
				            {"provider", type text},
				            {"waiting", Int64.Type},
				            {"within_18", Int64.Type},
				            {"over_52", Int64.Type},
				            {"over_65", Int64.Type},
				            {"median_weeks", type number},
				            {"p92_weeks", type number},
				            {"pct_within_18", type number},
				            {"pct_over_52", type number},
				            {"independent", type logical},
				            {"small", type logical},
				            {"p", type number},
				            {"z_binomial", type number},
				            {"z", type number},
				            {"band", type text}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

