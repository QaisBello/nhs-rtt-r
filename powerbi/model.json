  "measures": [
    {
      "name": "Latest Month",
      "table": "England",
      "folder": "England",
      "format": "mmmm yyyy",
      "dax": "CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )",
      "description": "Latest month of data."
    },
    {
      "name": "Waiting List",
      "table": "England",
      "folder": "England",
      "format": "#,0",
      "dax": "SUM ( England[waiting] )",
      "description": "Incomplete pathways (people waiting), reported providers only."
    },
    {
      "name": "Waiting List with Estimates",
      "table": "England",
      "folder": "England",
      "format": "#,0",
      "dax": "SUM ( England[waiting_with_estimates] )",
      "description": "Including NHS England's estimates for trusts that did not report."
    },
    {
      "name": "% Within 18 Weeks",
      "table": "England",
      "folder": "England",
      "format": "0.0%",
      "dax": "DIVIDE ( SUM ( England[within_18] ), SUM ( England[waiting] ) )",
      "description": "Share waiting less than 18 weeks (the constitutional standard is 92%)."
    },
    {
      "name": "92% Standard",
      "table": "England",
      "folder": "England",
      "format": "0%",
      "dax": "0.92",
      "description": "The constitutional standard."
    },
    {
      "name": "70% Target",
      "table": "England",
      "folder": "England",
      "format": "0%",
      "dax": "0.70",
      "description": "The March 2027 interim target."
    },
    {
      "name": "Latest Waiting List",
      "table": "England",
      "folder": "England",
      "format": "#,0",
      "dax": "VAR _last = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )\nRETURN CALCULATE ( [Waiting List], REMOVEFILTERS ( England ), England[month] = _last )",
      "description": "Waiting list in the latest month."
    },
    {
      "name": "Latest % Within 18 Weeks",
      "table": "England",
      "folder": "England",
      "format": "0.0%",
      "dax": "VAR _last = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )\nRETURN CALCULATE ( [% Within 18 Weeks], REMOVEFILTERS ( England ), England[month] = _last )",
      "description": "Share within 18 weeks in the latest month."
    },
    {
      "name": "Latest Median Wait",
      "table": "England",
      "folder": "England",
      "format": "0.0",
      "dax": "VAR _last = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )\nRETURN CALCULATE ( MAX ( England[median_weeks] ), REMOVEFILTERS ( England ), England[month] = _last )",
      "description": "Median wait in weeks, latest month (interpolated within weekly bands)."
    },
    {
      "name": "Latest 92nd Percentile",
      "table": "England",
      "folder": "England",
      "format": "0.0",
      "dax": "VAR _last = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )\nRETURN CALCULATE ( MAX ( England[p92_weeks] ), REMOVEFILTERS ( England ), England[month] = _last )",
      "description": "92nd percentile wait in weeks: the standard says 92% should wait less than 18."
    },
    {
      "name": "Latest Over 52 Weeks",
      "table": "England",
      "folder": "England",
      "format": "#,0",
      "dax": "VAR _last = CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ) )\nRETURN CALCULATE ( SUM ( England[over_52] ), REMOVEFILTERS ( England ), England[month] = _last )",
      "description": "Pathways waiting more than a year."
    },
    {
      "name": "Peak Waiting List",
      "table": "England",
      "folder": "England",
      "format": "#,0",
      "dax": "CALCULATE ( MAX ( England[waiting] ), REMOVEFILTERS ( England ) )",
      "description": "Largest list on record."
    },
    {
      "name": "Peak Month",
      "table": "England",
      "folder": "England",
      "format": "mmmm yyyy",
      "dax": "VAR _peak = [Peak Waiting List]\nRETURN\n    CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ), England[waiting] = _peak )",
      "description": "Month of the largest list."
    },
    {
      "name": "Last Month 92% Was Met",
      "table": "England",
      "folder": "England",
      "format": "mmmm yyyy",
      "dax": "CALCULATE ( MAX ( England[month] ), REMOVEFILTERS ( England ), England[within_18] >= 0.92 * England[waiting] )",
      "description": "The last month England met the 92% standard."
    },
    {
      "name": "Gap to 70%",
      "table": "England",
      "folder": "England",
      "format": "0.0\" points\"",
      "dax": "100 * ( [70% Target] - [Latest % Within 18 Weeks] )",
      "description": "Percentage points still to go."
    },
    {
      "name": "Pathways",
      "table": "Waiting by Provider",
      "folder": "Providers",
      "format": "#,0",
      "dax": "SUM ( 'Waiting by Provider'[waiting] )",
      "description": "Pathways waiting (provider extract)."
    },
    {
      "name": "Provider % Within 18 Weeks",
      "table": "Waiting by Provider",
      "folder": "Providers",
      "format": "0.0%",
      "dax": "DIVIDE ( SUM ( 'Waiting by Provider'[within_18] ), [Pathways] )",
      "description": "Share within 18 weeks for any provider, specialty or sector in context."
    },
    {
      "name": "Provider Over 52 Weeks",
      "table": "Waiting by Provider",
      "folder": "Providers",
      "format": "#,0",
      "dax": "SUM ( 'Waiting by Provider'[over_52] )",
      "description": "Pathways over a year."
    },
    {
      "name": "Share of List",
      "table": "Waiting by Provider",
      "folder": "Providers",
      "format": "0.0%",
      "dax": "DIVIDE ( [Pathways], CALCULATE ( [Pathways], REMOVEFILTERS ( Providers ) ) )",
      "description": "Share of all pathways in the extract (within any specialty filter)."
    },
    {
      "name": "Specialty % Within 18 Weeks",
      "table": "Specialties",
      "folder": "Specialties",
      "format": "0.0%",
      "dax": "DIVIDE ( SUM ( Specialties[within_18] ), SUM ( Specialties[waiting] ) )",
      "description": "England figure per treatment function (excludes non-English commissioners)."
    },
    {
      "name": "Specialty Over 52 Weeks",
      "table": "Specialties",
      "folder": "Specialties",
      "format": "#,0",
      "dax": "SUM ( Specialties[over_52] )",
      "description": "Pathways over a year, by treatment function."
    },
    {
      "name": "Funnel List Size",
      "table": "Funnel",
      "folder": "Funnel",
      "format": "#,0",
      "dax": "SUM ( Funnel[waiting] )",
      "description": "Trust waiting list (funnel x axis)."
    },
    {
      "name": "Funnel % Within 18 Weeks",
      "table": "Funnel",
      "folder": "Funnel",
      "format": "0.0%",
      "dax": "DIVIDE ( SUM ( Funnel[within_18] ), SUM ( Funnel[waiting] ) )",
      "description": "Trust performance (funnel y axis)."
    },
    {
      "name": "Trusts Better Than Chance",
      "table": "Funnel",
      "folder": "Funnel",
      "format": "#,0",
      "dax": "CALCULATE ( COUNTROWS ( Funnel ), Funnel[band] = \"Above 99.8% limit\" )",
      "description": "Above the overdispersed 99.8% limit."
    },
    {
      "name": "Trusts Worse Than Chance",
      "table": "Funnel",
      "folder": "Funnel",
      "format": "#,0",
      "dax": "CALCULATE ( COUNTROWS ( Funnel ), Funnel[band] = \"Below 99.8% limit\" )",
      "description": "Below the overdispersed 99.8% limit."
    },
    {
      "name": "Binomial Outliers",
      "table": "Funnel",
      "folder": "Funnel",
      "format": "#,0",
      "dax": "CALCULATE ( COUNTROWS ( Funnel ), ABS ( Funnel[z_binomial] ) > 3.09 )",
      "description": "Trusts outside plain binomial 99.8% limits: nearly all of them, which is why overdispersion matters."
    }
  ],
